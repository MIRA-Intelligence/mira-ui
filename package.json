{
  "name": "medpilot-ui",
  "version": "0.1.0",
  "description": "AI Agent UI for radiology workflows",
  "author": "Project MedPilot",
  "license": "GPL-3.0-or-later",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:electron": "node ./node_modules/electron-vite/dist/cli.mjs dev",
    "build:web": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:electron": "node ./node_modules/electron-vite/dist/cli.mjs build",
    "build:desktop": "npm run build:web && npm run build:electron",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "pack": "npm run build:desktop && node ./node_modules/electron-builder/cli.js --dir --publish never",
    "dist": "npm run build:desktop && node ./node_modules/electron-builder/cli.js --publish never",
    "dist:mac": "npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false node ./node_modules/electron-builder/cli.js --mac --publish never -c.electronDist=node_modules/electron/dist",
    "dist:win": "npm run build:desktop && node ./node_modules/electron-builder/cli.js --win --publish never",
    "dist:all": "npm run build:desktop && CSC_IDENTITY_AUTO_DISCOVERY=false node ./node_modules/electron-builder/cli.js --mac --win --publish never"
  },
  "build": {
    "appId": "com.projectmedpilot.medpilotui",
    "productName": "MedPilotUI",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "mac": {
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
