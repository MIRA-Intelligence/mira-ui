VITE_WS_URL=ws://localhost:18790/ws
VITE_API_URL=http://localhost:18790/api

# Optional: Vite dev-server proxy target when MIRA.app already uses 18790.
# VITE_DEV_GATEWAY_PORT=18791

# In-app feedback is relayed by the local mira-engine backend.
# Feishu webhook credentials are provided to bundle release workflows via
# GitHub Secrets and are not exposed as Vite renderer variables.
